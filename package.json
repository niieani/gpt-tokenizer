{
  "name": "gpt-tokenizer",
  "version": "0.0.0",
  "description": "A pure JavaScript implementation of a BPE tokenizer (Encoder/Decoder) for GPT-2 / GPT-3 / GPT-4 and other OpenAI models",
  "keywords": [
    "BPE",
    "encoder",
    "decoder",
    "tokenizer",
    "GPT",
    "GPT-2",
    "GPT-3",
    "GPT-3.5",
    "GPT-4",
    "GPT-4o",
    "NLP",
    "Natural Language Processing",
    "Text Generation",
    "OpenAI",
    "Machine Learning",
    "ml"
  ],
  "homepage": "https://github.com/niieani/gpt-tokenizer#readme",
  "bugs": {
    "url": "https://github.com/niieani/gpt-tokenizer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niieani/gpt-tokenizer.git"
  },
  "license": "MIT",
  "author": "Bazyli Brzoska <npm@invent.life> (https://github.com/niieani)",
  "contributors": [
    {
      "name": "Bazyli Brzoska",
      "email": "npm@invent.life",
      "url": "https://github.com/niieani"
    }
  ],
  "exports": {
    ".": {
      "import": "./esm/main.js",
      "require": "./cjs/main.js"
    },
    "./*": {
      "import": "./esm/*.js",
      "require": "./cjs/*.js"
    },
    "./cjs": {
      "require": "./cjs/main.js"
    },
    "./cjs/*": {
      "require": "./cjs/*.js"
    },
    "./esm/*": {
      "import": "./esm/*.js"
    },
    "./data/*": {
      "import": "./data/*",
      "require": "./data/*"
    },
    "./package.json": "./package.json"
  },
  "main": "esm/main.js",
  "module": "esm/main.js",
  "source": "src/main.ts",
  "files": [
    "src",
    "cjs",
    "esm",
    "data"
  ],
  "scripts": {
    "codegen": "yarn codegen:bpe && yarn codegen:chat-enabled && yarn codegen:models",
    "codegen:models": "rm -rf src/model && node --import node-resolve-ts/register src/codegen/generateByModel.ts",
    "codegen:bpe": "rm -rf src/bpeRanks && node --import node-resolve-ts/register src/codegen/generateJsBpe.ts",
    "codegen:chat-enabled": "rm -rf src/chat && node --import node-resolve-ts/register src/codegen/generateChatEnabled.ts",
    "build": "vp run clean && vp run build:cjs && vp run build:esm && node scripts/write-build-metadata.mjs && node scripts/verify-build.mjs",
    "build:cjs": "vp pack --format cjs --outDir cjs",
    "build:esm": "vp pack --format esm --outDir esm",
    "clean": "node scripts/clean.mjs",
    "format": "vp fmt \"src/**/*.{js,ts,json,md}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,json,md}\" \".github/**/*.yml\"",
    "prepare": "husky",
    "release": "semantic-release",
    "scrape:models": "node src/scraper/modelScrape.node.ts",
    "test": "vp check && vp test",
    "test:code": "vp test",
    "test:format": "vp fmt --check",
    "test:lint": "vp lint",
    "test:types": "vp check --no-lint --no-fmt"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "master",
      {
        "name": "main",
        "channel": false
      },
      "next",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "tagFormat": "${version}"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.13.3",
    "devalue": "^5.3.2",
    "husky": "^9.1.7",
    "node-resolve-ts": "^1.0.2",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "access": "public"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  }
}
