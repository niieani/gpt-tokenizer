+
+test('vocabulary and cached pieces treat prototype names as ordinary keys', () => {
+  const ranks = [
+    ...Array.from('abcdefghijklmnopqrstuvwxyz_'),
+    '__proto__',
+    'constructor',
+  ]
+  const core = new BytePairEncodingCore({
+    bytePairRankDecoder: ranks,
+    tokenSplitRegex: /.+/gu,
+    mergeCacheSize: 1,
+  })
+  expect(core.encodeNative('__proto__')).toEqual([27])
+  expect(core.encodeNative('constructor')).toEqual([28])
+  // Non-vocabulary pieces still use the bounded cache.
+  const text = 'valueof'
+  const tokens = Array.from(text).map((letter) => ranks.indexOf(letter))
+  expect(core.encodeNative(text)).toEqual(tokens)
+  expect(core.countNative(text)).toBe(tokens.length)
+  core.clearMergeCache()
+  core.setMergeCacheSize(0)
+  expect(core.encodeNative(text)).toEqual(tokens)
+})
+
+test('prototype-name cache misses remain ordinary keys through eviction', () => {
+  const ranks = Array.from('abcdefghijklmnopqrstuvwxyz_')
+  const core = new BytePairEncodingCore({
+    bytePairRankDecoder: ranks,
+    tokenSplitRegex: /.+/gu,
+    mergeCacheSize: 1,
+  })
+  const tokens = (text: string) =>
+    Array.from(text, (char) => ranks.indexOf(char))
+  for (const text of ['__proto__', 'constructor', '__proto__']) {
+    const expected = tokens(text)
+    expect(core.encodeNative(text)).toEqual(expected)
+    expect(core.countNative(text)).toBe(expected.length)
+    expect(Array.from(core.encodeNativeGenerator(text)).flat()).toEqual(
+      expected,
+    )
+  }
+  core.clearMergeCache()
+  expect(core.encodeNative('__proto__')).toEqual(tokens('__proto__'))
+  core.setMergeCacheSize(0)
+  expect(core.encodeNative('constructor')).toEqual(tokens('constructor'))
+})
+
+test('selects a single engine-appropriate vocabulary lookup', () => {
+  const core = new BytePairEncodingCore({
+    bytePairRankDecoder: ['a'],
+    tokenSplitRegex: /.+/gu,
+  })
+  const lookup = Reflect.get(
+    core,
+    'bytePairStringRankEncoder',
+  ) as InspectedLookup
+  if (process.versions.bun !== undefined) expect(lookup).toBeInstanceOf(Map)
+  else expect(Object.getPrototypeOf(lookup)).toBeNull()
+  expect(lookupGet(lookup, 'a')).toBe(0)
+})
