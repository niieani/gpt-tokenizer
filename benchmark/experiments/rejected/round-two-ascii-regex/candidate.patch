+import { describe, expect, test } from 'vite-plus/test'
+import {
+  CL100K_TOKEN_SPLIT_REGEX,
+  O200K_TOKEN_SPLIT_REGEX,
+  R50K_TOKEN_SPLIT_REGEX,
+} from './encodingParams/constants.js'
+
+// Compare dispatch to the canonical Unicode16 pattern, including controls and
+// mixed case/punctuation boundaries that exercise alternative precedence.
+describe.each([
+  R50K_TOKEN_SPLIT_REGEX,
+  CL100K_TOKEN_SPLIT_REGEX,
+  O200K_TOKEN_SPLIT_REGEX,
+])('ASCII regex specialization', (regex) => {
+  test('all ASCII pairs match the canonical pattern', () => {
+    const canonical = new RegExp(regex.source, regex.flags)
+    for (let first = 0; first < 128; first++) {
+      for (let second = 0; second < 128; second++) {
+        const text = String.fromCharCode(first, second)
+        expect(text.match(regex)).toEqual(text.match(canonical))
+      }
+    }
+  })
+
+  test('seeded strings preserve matches and interleaved iterator state', () => {
+    let seed = 0x24a0f37
+    const random = () => {
+      seed ^= seed << 13
+      seed ^= seed >>> 17
+      seed ^= seed << 5
+      return seed >>> 0
+    }
+    const canonical = new RegExp(regex.source, regex.flags)
+    for (let sample = 0; sample < 500; sample++) {
+      const text = Array.from({ length: 8 + (random() % 120) }, () =>
+        String.fromCharCode(random() % 128),
+      ).join('')
+      expect(text.match(regex)).toEqual(text.match(canonical))
+      regex.lastIndex = canonical.lastIndex = random() % text.length
+      const iterator = text.matchAll(regex)
+      const expected = Array.from(text.matchAll(canonical))
+      expect(regex.exec('Mixed CASE123\r\n')).toEqual(
+        canonical.exec('Mixed CASE123\r\n'),
+      )
+      // A live iterator owns its lastIndex even if the shared regex is used.
+      expect(Array.from(iterator)).toEqual(expected)
+      regex.lastIndex = canonical.lastIndex = 0
+    }
+  })
+})
