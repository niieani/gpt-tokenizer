+
+test('vocabulary and cached pieces treat prototype names as ordinary keys', () => {
+  const ranks = [
+    ...Array.from('abcdefghijklmnopqrstuvwxyz_'),
+    '__proto__',
+    'constructor',
+  ]
+  const core = new BytePairEncodingCore({
+    bytePairRankDecoder: ranks,
+    tokenSplitRegex: /.+/gu,
+    mergeCacheSize: 1,
+  })
+  expect(core.encodeNative('__proto__')).toEqual([27])
+  expect(core.encodeNative('constructor')).toEqual([28])
+  // Non-vocabulary pieces still use the bounded cache.
+  const text = 'valueof'
+  const tokens = Array.from(text).map((letter) => ranks.indexOf(letter))
+  expect(core.encodeNative(text)).toEqual(tokens)
+  expect(core.countNative(text)).toBe(tokens.length)
+  core.clearMergeCache()
+  core.setMergeCacheSize(0)
+  expect(core.encodeNative(text)).toEqual(tokens)
+})
