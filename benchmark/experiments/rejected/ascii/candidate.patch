+import { describe, expect, test } from 'vite-plus/test'
+import { asciiO200kPieceEnd } from './asciiO200k.js'
+import ranks from './bpeRanks/o200k_base.js'
+import { BytePairEncodingCore } from './BytePairEncodingCore.js'
+import { O200K_TOKEN_SPLIT_REGEX } from './encodingParams/constants.js'
+
+function scannedPieces(text: string): string[] {
+  const regex = new RegExp(O200K_TOKEN_SPLIT_REGEX)
+  const pieces: string[] = []
+  let position = 0
+  while (position < text.length) {
+    let end = asciiO200kPieceEnd(text, position)
+    if (end < 0) {
+      regex.lastIndex = position
+      const match = regex.exec(text)!
+      expect(match.index).toBe(position)
+      end = regex.lastIndex
+    }
+    expect(end).toBeGreaterThan(position)
+    pieces.push(text.slice(position, end))
+    position = end
+  }
+  return pieces
+}
+
+function expectedPieces(text: string): string[] {
+  return text.match(O200K_TOKEN_SPLIT_REGEX) ?? []
+}
+
+const boundaries = [
+  '',
+  'hello',
+  'UPPERCaseABCdef',
+  "I'M we've HE'LL they're I'd can't abc'Sx",
+  "'s 't 'll 're 've 'm 'd",
+  '1234567 abc123DEF',
+  '!\n/abc !\r\n///!def',
+  ' \t\r\n  abc\v\f xyz ',
+  'a\u0085b\ufeffc\u00a0d',
+  'abcé café e\u0301 abc中文 abc😀',
+  "abc'S\u0301 abc\u0301'S ABC中文def",
+  'a123٤5 a!。x a 　x',
+  'a\ud800b a\udc00b a\r\n\ufeffb',
+]
+let seed = 0x58ab71d4
+const random = () => (seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0)
+const randomAscii = Array.from({ length: 2000 }, (_, n) => {
+  let text = ''
+  for (let i = 0; i < n % 257; i++) text += String.fromCharCode(random() >>> 25)
+  return text
+})
+const mixed = Array.from({ length: 250 }, (_, n) => {
+  let text = 'Ascii'
+  for (let i = 0; i < n % 41; i++) {
+    const choices = [
+      'é',
+      '\u0301',
+      '中',
+      '😀',
+      '\u0085',
+      '\ufeff',
+      '\u00a0',
+      '\ud800',
+      '\udc00',
+      '٤',
+    ]
+    text +=
+      String.fromCharCode(random() >>> 25) + choices[random() % choices.length]
+  }
+  return text
+})
+
+describe('ASCII o200k pretokenizer', () => {
+  test('matches every pair of ASCII characters', () => {
+    for (let a = 0; a < 128; a++) {
+      for (let b = 0; b < 128; b++) {
+        const text = String.fromCharCode(a, b)
+        expect(scannedPieces(text)).toEqual(expectedPieces(text))
+      }
+    }
+  })
+  test('matches seeded ASCII text and uncertain Unicode boundaries', () => {
+    for (const text of [...boundaries, ...randomAscii, ...mixed]) {
+      expect(scannedPieces(text)).toEqual(expectedPieces(text))
+    }
+  })
+  test('keeps tokens and counts exact across cache capacities', () => {
+    const fast = new BytePairEncodingCore({
+      bytePairRankDecoder: ranks,
+      tokenSplitRegex: O200K_TOKEN_SPLIT_REGEX,
+    })
+    const regex = new BytePairEncodingCore({
+      bytePairRankDecoder: ranks,
+      tokenSplitRegex: O200K_TOKEN_SPLIT_REGEX,
+    })
+    Reflect.set(regex, 'asciiO200k', false)
+    for (const capacity of [0, 1, 64, 100_000]) {
+      fast.setMergeCacheSize(capacity)
+      regex.setMergeCacheSize(capacity)
+      for (const text of [
+        ...boundaries,
+        ...randomAscii.slice(0, 100),
+        ...mixed.slice(0, 50),
+      ]) {
+        const expected = regex.encodeNative(text)
+        expect(fast.encodeNative(text)).toEqual(expected)
+        expect(fast.countNative(text)).toBe(expected.length)
+        expect([...fast.encodeNativeGenerator(text)].flat()).toEqual(expected)
+      }
+    }
+  })
+})
