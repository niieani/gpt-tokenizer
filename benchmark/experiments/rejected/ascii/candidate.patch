+// ASCII fast-path idea: goliajp/rust-tiktoken (MIT OR Apache-2.0),
+// https://github.com/goliajp/rust-tiktoken/blob/v4.1.2/tiktoken/src/pretokenize.rs
+// This scanner independently implements our O200K_TOKEN_SPLIT_REGEX branches.
+// An uncertain Unicode boundary returns -1 so the original regex decides it.
+const LETTER = 1
+const UPPER = 2
+const LOWER = 4
+const DIGIT = 8
+const SPACE = 16
+const NEWLINE = 32
+const PUNCT = 64
+const classes = new Uint8Array(128)
+for (let code = 0; code < 128; code++) {
+  classes[code] =
+    code >= 65 && code <= 90
+      ? LETTER | UPPER
+      : code >= 97 && code <= 122
+        ? LETTER | LOWER
+        : code >= 48 && code <= 57
+          ? DIGIT
+          : (code >= 9 && code <= 13) || code === 32
+            ? SPACE | (code === 10 || code === 13 ? NEWLINE : 0)
+            : PUNCT
+}
+
+export function asciiO200kPieceEnd(text: string, start: number): number {
+  const code = text.charCodeAt(start)
+  if (code >= 128) return -1
+  const kind = classes[code]!
+  let wordStart = start
+  if (!(kind & LETTER)) {
+    wordStart = -1
+    if (!(kind & (DIGIT | NEWLINE))) {
+      const next = text.charCodeAt(start + 1)
+      if (next >= 128) return -1
+      if (classes[next]! & LETTER) wordStart = start + 1
+    }
+  }
+  if (wordStart >= 0) {
+    let end = wordStart
+    while (classes[text.charCodeAt(end)]! & UPPER) end++
+    while (classes[text.charCodeAt(end)]! & LOWER) end++
+    if (text.charCodeAt(end) >= 128) return -1
+    if (text.charCodeAt(end) === 39) {
+      const suffix = text.charCodeAt(end + 1) | 32
+      if (
+        suffix === 115 ||
+        suffix === 100 ||
+        suffix === 109 ||
+        suffix === 116
+      ) {
+        end += 2
+      } else {
+        const tail = text.charCodeAt(end + 2) | 32
+        if (
+          (suffix === 108 && tail === 108) ||
+          (suffix === 114 && tail === 101) ||
+          (suffix === 118 && tail === 101)
+        ) {
+          end += 3
+        }
+      }
+    }
+    return end
+  }
+  if (kind & DIGIT) {
+    let end = start + 1
+    while (end - start < 3 && classes[text.charCodeAt(end)]! & DIGIT) end++
+    return end - start < 3 && text.charCodeAt(end) >= 128 ? -1 : end
+  }
+  if (
+    kind & PUNCT ||
+    (code === 32 && classes[text.charCodeAt(start + 1)]! & PUNCT)
+  ) {
+    let end = start + (code === 32 ? 1 : 0)
+    while (classes[text.charCodeAt(end)]! & PUNCT) end++
+    if (text.charCodeAt(end) >= 128) return -1
+    while (
+      text.charCodeAt(end) === 10 ||
+      text.charCodeAt(end) === 13 ||
+      text.charCodeAt(end) === 47
+    )
+      end++
+    return end
+  }
+  let end = start
+  let lastNewline = -1
+  while (classes[text.charCodeAt(end)]! & SPACE) {
+    if (classes[text.charCodeAt(end)]! & NEWLINE) lastNewline = end + 1
+    end++
+  }
+  if (text.charCodeAt(end) >= 128) return -1
+  if (lastNewline >= 0) return lastNewline
+  return end === text.length || end === start + 1 ? end : end - 1
+}
